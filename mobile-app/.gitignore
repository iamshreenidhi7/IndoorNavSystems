# Flutter/Dart tooling state and build output (AGENTS.md 15.1: never commit
# build output, IDE settings or generated files the build recreates).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Platform build output, once android/ and ios/ exist (generated by
# `flutter create`, not hand-authored - see the summary for this task).
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/

# Editors/IDEs.
.vscode/
.idea/
*.iml

# Coverage output.
coverage/
